# Template committed to git. Copy to .env.development.local and fill in
# the placeholder values before running `npm run dev`.
# .env.development.local is gitignored (.env.*.local rule).

VITE_API_BASE_URL=http://localhost:50051

# Google OAuth (same client as the backend, since it's one OAuth app per client)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
