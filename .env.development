# Template committed to git. Copy to .env.development.local and fill in
# the placeholder secrets before starting the dev container.
# .env.development.local is gitignored and is the file actually loaded
# by docker compose (see .devcontainer/compose.yaml).

ENVIRONMENT=development

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=50051

# Database Configuration
DATABASE_DSN=postgres://reverie:reverie@reverie-db:5432/reverie_db
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m

# Authentication Configuration
# Generate a 32-byte random string for local dev, e.g. `openssl rand -hex 32`.
AUTH_JWT_SECRET_KEY=
AUTH_ACCESS_EXPIRATION=15m
AUTH_REFRESH_EXPIRATION=720h # 30 days

# Logging Configuration
LOG_LEVEL=debug

# Google OAuth (create your own OAuth client at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/auth/callback
